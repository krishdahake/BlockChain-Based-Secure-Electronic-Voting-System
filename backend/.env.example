PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (see README)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-voting?retryWrites=true&w=majority

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Gmail SMTP (use a Google App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Where the Contact form delivers messages (defaults to SMTP_USER)
CONTACT_EMAIL=

# Blockchain
RPC_URL=http://127.0.0.1:8545
# Optional - defaults to the address in config/Voting.json written by the deploy script
CONTRACT_ADDRESS=
# Private key of the account that DEPLOYED the contract (holds ADMIN_ROLE).
# Used only for admin setup transactions (create election / add candidate / register voter).
# For local dev this is Hardhat account #0 - a well-known, worthless key. NEVER use a real-funds key.
ADMIN_PRIVATE_KEY=
